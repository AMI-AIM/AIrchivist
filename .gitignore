# Progetti di ricerca (corpus, schede, serie, risultati, indice, copie di sicurezza): non si pubblicano, per le
# dimensioni e per i diritti delle fonti. Il motore porta solo il modello scripts/series_template.ini e il
# progetto di prova dei test (tests/test_project/); un progetto nuovo: python scripts/progetto.py nuovo projects/<nome>
projects/

# Documenti di lavoro interni (fuori dal repository pubblico)
_docs_interni/

# Profili dei modelli di chi usa il motore (il modello pubblico è scripts/models_template.ini)
scripts/models.ini

# Scelte dell'utente nel modo sviluppo (progetto, modello: posizioni.py); scripts/config.ini resta quello pubblico
scripts/config.utente.ini

# Marcatore del programma installato (lo mette l'installatore: scripts/posizioni.py)
scripts/installazione.ini

# Costruzione del programma per Windows
confezione/

# File temporanei
__pycache__/
*.pyc
*.bak
*.bak[0-9]*
.senza_archivio

# Strumenti di sviluppo locali (assistente, verifiche di design, cache dei test)
.claude/
.impeccable/
.pytest_cache/

# Sistema
Thumbs.db
desktop.ini
